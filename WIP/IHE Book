@startuml
title Patient Identity Cross Referencing
component reg as "Patient Identity Source"
component ehr as "Patient Identifier Cross Reference Consumer"
interface iti44 <<V3>> as "[ITI-44] Patient Identity Feed V3" #orange
interface iti30 <<V2>> as "[ITI-30] Patient Identity Management V2.5.1"
interface iti08 <<V2>> as "[ITI-08] Patient Identity Feed"
component mpi as "Patient Identifier Cross Reference Manager"
interface iti09 <<V2>> as "[ITI-09] PIX Query"
interface iti10 <<V2>> as "[ITI-10] PIX Update Notification"
interface iti45 <<V3>> as "[ITI-45] PIXV3 Query" #orange
interface iti46 <<V3>> as "[ITI-46] PIXV3 Update Notification" #orange
interface iti83 <<FHIR>> as "[ITI-83] Mobile Patient Identifier Cross Reference Query" #red
reg -down-> iti08
reg -down-> iti44
reg .down.> iti30
mpi -up- iti08
mpi -up- iti44
mpi .up. iti30
mpi -down- iti09
mpi -down- iti45
mpi -down- iti83
mpi .down.> iti10
mpi .down.> iti46
ehr -up-> iti09
ehr -up-> iti45
ehr -up-> iti83
ehr .up. iti10
ehr .up. iti46
@enduml
@startuml
title Simplified PIX V2
skinparam Shadowing false
rectangle v2 <<V2>> as " " {
skinparam RectangleBorderColor #white
interface iti08 as "[ITI-08] Patient Identity Feed"
interface iti30 as "[ITI-30] Patient Identity Management V2.5.1"
interface iti10 as "[ITI-10] PIX Update Notification"
interface iti09 as "[ITI-09] PIX Query"
iti08 -[hidden]- iti30
iti30 -[hidden]- iti10
iti10 -[hidden]- iti09
}

component cl as "PIX Client"
component sv as "PIX Server"

cl -r-> iti08
cl .r.> iti30
iti08 -l- sv 
iti30 .l. sv  
iti09 -l- sv 
iti10 <.l. sv
cl -r-> iti09
cl .r. iti10

@enduml

